:root{
      --primary: #e84a2a;
      --primary-light: #ff6b4a;
      --primary-dark: #c73d1f;
      --primary-bg: #fef6f3;
      --gray-1: #f8f9fb;
      --gray-2: #eef0f2;
      --gray-3: #d5d8dd;
      --gray-4: #9ea3ac;
      --gray-5: #6b7078;
      --gray-6: #2d3138;
      --radius: 16px;
      --radius-sm: 10px;
      --shadow: 0 8px 30px rgba(0,0,0,0.08);
      --shadow-hover: 0 12px 40px rgba(0,0,0,0.15);
      --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body{
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--gray-6);
      min-height: 100vh;
      padding-bottom: 80px;
      background: linear-gradient(145deg, #fff5f0 0%, #fde8dd 100%);
      position: relative;
    }
    body::before{ content: ''; position: fixed; top: -20%; right: -10%; width: 60%; height: 80%; background: radial-gradient(circle, rgba(232,74,42,0.10) 0%, transparent 70%); pointer-events: none; z-index: 0; }
    body::after{ content: ''; position: fixed; bottom: -20%; left: -10%; width: 50%; height: 70%; background: radial-gradient(circle, rgba(255,140,76,0.08) 0%, transparent 70%); pointer-events: none; z-index: 0; }
    html, body { overscroll-behavior: none; -webkit-overflow-scrolling: auto; }
    body { position: fixed; width: 100%; height: 100%; overflow: hidden; }
    #mainContent { height: 100%; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
    header{
      position: sticky; top: 0; z-index: 100;
      background: linear-gradient(135deg, #ff8a4c 0%, #e84a2a 100%);
      color: #fff;
      padding: 12px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      box-shadow: 0 10px 28px rgba(200, 65, 30, .22);
      border-radius: 0 0 22px 22px;
    }
    header .header-title{ font-size: 20px; font-weight: 700; display: flex; align-items: center; gap: 8px; white-space: nowrap; flex-shrink: 0; }
    header .header-left{ display: flex; align-items: center; gap: 10px; min-width: 0; flex: 1; justify-content: center; }
    header .header-right{ display: flex; align-items: center; gap: 10px; flex-wrap: wrap; flex-shrink: 0; }
    header .waiter-name{ background: rgba(255,255,255,0.2); padding: 4px 14px; border-radius: 30px; font-weight: 600; font-size: 14px; }
    header .store-name{ background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.25); padding: 4px 14px; border-radius: 30px; font-weight: 600; font-size: 14px; }
    header .header-btn{ background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.25); color: #fff; padding: 5px 14px; border-radius: 30px; font-size: 13px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    header .header-btn:hover{ background: rgba(255,255,255,0.3); }
    header .icon-btn{ width: 34px; height: 34px; min-width: 34px; padding: 0; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 16px; line-height: 1; position: relative; }
    header .call-notification-btn #callNotificationCount{ position: absolute; top: -4px; right: -4px; background: #ff3b30; color: #fff; font-size: 10px; font-weight: 700; min-width: 16px; height: 16px; border-radius: 8px; display: flex; align-items: center; justify-content: center; padding: 0 4px; line-height: 1; }
    header .call-notification-btn{ position: relative; background: #ff7a45; color: #fff; border: 0; padding: 5px 14px; border-radius: 30px; cursor: pointer; font-weight: 600; font-size: 13px; }
    .lang-btn-wrap{ width: 34px; height: 34px; min-width: 34px; max-width: 34px; border-radius: 50%; background: rgba(255,255,255,0.2); display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; padding: 0; margin: 0; box-sizing: border-box; overflow: hidden; position: relative; }
    .lang-btn-wrap .lang-icon{ font-size: 16px; line-height: 1; pointer-events: none; }
    .lang-btn-wrap select{ position: absolute; inset: 0; opacity: 0; cursor: pointer; border: none; background: transparent; color: transparent; padding: 0; margin: 0; width: 100%; height: 100%; }
    header select option{ color: var(--gray-6); background: #fff; }
    main{ max-width: 1000px; margin: 20px auto; padding: 0 16px; position: relative; z-index: 1; }
    .table-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
    .table-card{ position: relative; background: #fff; border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); border: 1px solid rgba(0,0,0,0.04); cursor: pointer; transition: var(--transition); }
    .table-card:hover{ transform: translateY(-4px); box-shadow: var(--shadow-hover); }
    .table-card .name{ font-size: 22px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .table-card .name .status{ margin-top: 0; font-size: 12px; padding: 2px 10px; font-weight: 500; }
    .table-card .status{ display: inline-block; margin-top: 4px; padding: 2px 14px; border-radius: 30px; font-size: 12px; font-weight: 600; }
    .status.available{ background: #e3f5e3; color: #1d7a3e; }
    .status.occupied{ background: #fff0e0; color: #b85c2a; }
    .status.reserved{ background: #e3edfc; color: #2a5fb8; }
    .table-card .bill{ margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--gray-2); font-size: 14px; }
    .table-card .amount{ font-weight: 700; color: var(--primary); font-size: 16px; }
    .bill-items{ margin-top: 6px; display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
    .bill-items .line{ display: grid; grid-template-columns: 1fr 64px 72px; align-items: center; gap: 6px; padding: 4px 0; border-bottom: 1px dashed var(--gray-2); }
    .bill-items .dish-name{ min-width:0; color: var(--gray-6); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .order-detail-item{ display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid #f0f0f0; gap:10px; }
    .order-detail-item .dish-name{ flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .order-detail-item .item-price{ color:#e74c3c; flex-shrink:0; }
    .line-amount{ text-align:right; color: var(--gray-5); }
    .bill-items .line .item-status, .bill-items .line .item-toggle{ justify-self:center; text-align:center; white-space:nowrap; }
    .item-status{ padding: 2px 10px; border-radius: 30px; font-size: 11px; font-weight: 600; background: rgba(250, 140, 22, .15); color: #fa8c16; }
    .item-status.done{ background: rgba(82, 196, 26, .15); color: #52c41a; }
    .item-toggle{ border: 0; padding: 3px 12px; border-radius: 30px; font-size: 12px; font-weight: 600; background: rgba(250, 140, 22, .15); color: #fa8c16; cursor: pointer; transition: var(--transition); }
    .item-toggle.done{ background: rgba(82, 196, 26, .15); color: #52c41a; }
    .order-block{ margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--gray-2); }
    .order-head{ display: flex; justify-content: space-between; align-items: center; font-weight: 600; margin-bottom: 4px; }
    .order-head .order-meta{ font-weight: 400; font-size: 12px; color: #c8c8d0; }
    .session-badge{ display: inline-block; padding: 1px 8px; border-radius: 999px; background: rgba(123, 104, 238, .15); color: #7b68ee; font-size: 11px; font-weight: 700; margin-left: 4px; }
    .order-head button{ background: #e3f5e3; border: 1px solid #b7dbb7; color: #1d7a3e; border-radius: 30px; padding: 2px 12px; font-size: 12px; cursor: pointer; transition: var(--transition); }
    .order-head button:hover{ background: #c8eac8; }
    .modal{ position: fixed; inset: 0; background: rgba(0,0,0,0.4); backdrop-filter: blur(4px); display: none; align-items: center; justify-content: center; z-index: 200; padding: 16px; overscroll-behavior: contain; }
    .modal.open{ display: flex; }
    html[data-waiter-session] .login-modal.open{ display: none; }
    .modal-card{ background: #fff; border-radius: var(--radius); max-width: 920px; width: 100%; max-height: 90vh; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,0.2); padding: 24px; min-height: 0; overscroll-behavior: contain; }
    .modal-head{ display: flex; justify-content: space-between; align-items: center; padding-bottom: 14px; border-bottom: 1px solid var(--gray-2); flex-shrink: 0; }
    .modal-head h2{ font-size: 20px; font-weight: 700; margin: 0; }
    .close{ background: var(--gray-2); border: 0; width: 36px; height: 36px; border-radius: 50%; font-size: 18px; cursor: pointer; transition: var(--transition); }
    .close:hover{ background: var(--gray-3); }
    .modal-body{ overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
    .confirm-modal .confirm-card{ max-width: 380px; padding: 32px 28px 28px; text-align: center; border-radius: 20px; }
    .confirm-icon{ font-size: 48px; margin-bottom: 16px; }
    .confirm-title{ font-size: 20px; font-weight: 700; color: #1a1a2e; margin-bottom: 10px; }
    .confirm-message{ font-size: 15px; color: #666; line-height: 1.6; margin-bottom: 24px; }
    .confirm-buttons{ display: flex; gap: 12px; justify-content: center; }
    .confirm-cancel, .confirm-ok{ flex: 1; padding: 12px 24px; border: 0; border-radius: 12px; font-size: 15px; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
    .confirm-cancel{ background: #f0f0f5; color: #666; }
    .confirm-cancel:hover{ background: #e4e4ec; }
    .confirm-ok{ background: linear-gradient(135deg, #e85d3a, #e84a2a); color: #fff; }
    .confirm-ok:hover{ transform: translateY(-2px); box-shadow: 0 8px 20px rgba(232,93,58,0.3); }
    .login-modal .modal-card{ max-width: 420px; padding: 32px 28px 28px; background: rgba(255,255,255,0.92); backdrop-filter: blur(12px); border-radius: 28px; border: 1px solid rgba(255,255,255,0.3); box-shadow: 0 30px 80px rgba(0,0,0,0.15); position: relative; z-index: 1; }
    .login-modal .modal-head{ border-bottom: none; padding-bottom: 8px; }
    .login-modal .modal-head h2{ font-size: 26px; font-weight: 700; display: flex; align-items: center; gap: 12px; }
    .login-modal .modal-head h2 .brand-icon{ font-size: 32px; }
    .login-modal .form-group{ margin-bottom: 14px; }
    .login-modal .form-group input{ width: 100%; height: 48px; padding: 0 16px; border-radius: var(--radius-sm); border: 1.5px solid var(--gray-3); font-size: 15px; transition: var(--transition); background: rgba(255,255,255,0.8); }
    .login-modal .form-group input:focus{ outline: none; border-color: var(--primary); box-shadow: 0 0 0 4px rgba(232,74,42,0.12); background: #fff; }
    .login-modal .form-group label{ display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--gray-5); cursor: pointer; }
    .login-modal .form-group label input[type="checkbox"]{ width: 18px; height: 18px; accent-color: var(--primary); }
    .login-btn{ width: 100%; height: 50px; border: 0; border-radius: var(--radius-sm); background: var(--primary); color: #fff; font-size: 18px; font-weight: 700; cursor: pointer; transition: var(--transition); margin-top: 4px; }
    .login-btn:hover{ background: var(--primary-dark); transform: translateY(-1px); }
    .login-btn:active{ transform: scale(0.97); }
    .login-error{ color: var(--primary); margin-top: 10px; font-size: 14px; text-align: center; min-height: 22px; }
    .current-table{ background: var(--primary-bg); border: 1px solid #f5d5c8; color: var(--primary-dark); font-weight: 600; padding: 8px 14px; border-radius: var(--radius-sm); font-size: 15px; flex: 1; }
    .modal-head .current-table{ margin-bottom: 0; background: transparent; border: none; padding: 0; font-size: 18px; font-weight: 700; color: var(--gray-6); }
    .selected-items{ flex-shrink: 0; background: var(--gray-1); border-radius: var(--radius-sm); padding: 12px 14px; max-height: 110px; overflow-y: auto; margin-bottom: 12px; scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
    .selected-items::-webkit-scrollbar{ display: none; }
    .selected-items .title{ font-weight: 600; margin-bottom: 8px; color: var(--gray-5); }
    .selected-item{ display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 8px; padding: 6px 0; border-bottom: 1px solid var(--gray-2); }
    .selected-item:last-child{ border-bottom: 0; }
    .selected-item .sel-name{ min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; display: flex; align-items: center; gap: 6px; }
    .item-status.new{ background: var(--primary-bg); color: var(--primary); padding: 1px 6px; border-radius: 8px; font-size: 10px; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
    .selected-item .sel-price{ color: var(--gray-5); font-size: 13px; white-space: nowrap; }
    .selected-item .qty{ gap: 4px; }
    .selected-item .qty button{ width: 26px; height: 26px; font-size: 14px; }
    .selected-item .qty span{ min-width: 18px; font-size: 13px; }
    .selected-item .remove-btn{ background: #fee8e6; border: 0; color: var(--primary); padding: 2px 10px; border-radius: 30px; font-size: 12px; cursor: pointer; white-space: nowrap; transition: var(--transition); }
    .selected-item .remove-btn:hover{ background: #fdd5d0; }
    .dish-categories{ display: flex; gap: 8px; overflow-x: auto; padding: 8px 0; margin-bottom: 8px; scrollbar-width: none; -ms-overflow-style: none; flex-shrink: 0; -webkit-overflow-scrolling: touch; }
    .dish-categories::-webkit-scrollbar{ display: none; }
    .dish-categories .cat-btn{ padding: 6px 14px; border-radius: 20px; border: 1px solid var(--gray-3); background: #fff; font-size: 13px; cursor: pointer; white-space: nowrap; transition: all 0.2s; flex-shrink: 0; }
    .dish-categories .cat-btn:hover{ border-color: var(--primary); color: var(--primary); }
    .dish-categories .cat-btn.active{ background: var(--primary); color: #fff; border-color: var(--primary); font-weight: 600; }
    .dish-list{
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      flex: 1;
      min-height: 0;                             /* ★ 修复：flex item 必须显式置 0 才能滚动 */
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;         /* ★ 修复：iOS 惯性滚动 */
      overscroll-behavior: contain;              /* ★ 修复：防止滚动穿透 */
      padding: 6px 2px 12px 0;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .dish-list::-webkit-scrollbar{ display: none; }
    .dish-item{ display: flex; align-items: center; gap: 12px; background: var(--gray-1); border-radius: var(--radius-sm); padding: 12px 14px; border: 1px solid var(--gray-2); transition: var(--transition); }
    .dish-item:hover{ background: #fff; border-color: var(--gray-3); }
    .dish-thumb{ width: 56px; height: 56px; border-radius: var(--radius-sm); background: var(--gray-2); display: flex; align-items: center; justify-content: center; font-size: 28px; overflow: hidden; flex-shrink: 0; }
    .dish-thumb img{ width:100%; height:100%; object-fit:cover; }
    .dish-item .info{ flex:1; min-width:0; }
    .dish-item .info .name{ font-weight:600; font-size:15px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .dish-item .info .price{ color: var(--primary); font-size:14px; font-weight:500; }
    .price-secondary{ font-size:12px; color: var(--gray-4); margin-left:4px; }
    .qty{ display: flex; align-items: center; gap: 6px; flex-shrink: 0; white-space: nowrap; }
    .qty button{ width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--gray-3); background: #fff; font-size: 16px; cursor: pointer; transition: var(--transition); display: flex; align-items: center; justify-content: center; }
    .qty button:hover{ border-color: var(--primary); color: var(--primary); }
    .qty span{ min-width: 24px; text-align: center; font-weight: 600; }
    .footer{ flex-shrink: 0; display: flex; justify-content: space-between; align-items: center; padding-top: 16px; margin-top: 12px; border-top: 1px solid var(--gray-2); }
    .footer .total{ font-size: 22px; font-weight: 700; color: var(--primary); }
    .submit-btn{ background: var(--primary); border: 0; color: #fff; padding: 10px 28px; border-radius: 30px; font-weight: 600; font-size: 15px; cursor: pointer; transition: var(--transition); }
    .submit-btn:hover{ background: var(--primary-dark); transform: translateY(-2px); }
    .submit-btn:active{ transform: scale(0.97); }
    @media (max-width: 600px) {
      header{ padding: 10px 14px; gap: 8px; display: flex !important; flex-wrap: wrap !important; }
      header .header-title{ position: static !important; transform: none !important; order: 0; width: 100%; text-align: center; justify-content: center; font-size: 17px; padding-bottom: 8px; border-bottom: 1px solid rgba(255,255,255,0.15); }
      header .header-right{ order: 2; margin-left: 0 !important; flex: 1; justify-content: flex-end; flex-wrap: nowrap !important; gap: 6px !important; }
      header .header-left{ order: 1; margin-left: 0 !important; gap: 6px !important; }
      header .header-btn{ padding: 4px 10px !important; font-size: 12px !important; }
      header .icon-btn{ width: 30px !important; height: 30px !important; min-width: 30px !important; font-size: 14px !important; }
      header .waiter-name, header .store-name{ padding: 3px 10px !important; font-size: 12px !important; }
      .login-modal .modal-card{ padding: 24px 18px 20px; }
      .dish-list{ grid-template-columns: 1fr; }
      .table-grid{ grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .selected-item{ grid-template-columns: 1fr auto auto; row-gap: 4px; }
      .selected-item .sel-price{ grid-column: 1 / 2; font-size: 12px; }
    }
/* ===== 编辑卡片"结算"按钮 hover（主样式在 HTML inline） ===== */
.settle-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(46, 204, 113, 0.35) !important;
  filter: brightness(1.05);
}
.settle-btn:active {
  transform: scale(0.97);
}

/* ============================================================
   桌台搜索栏 + 过滤 Tab（2026-09-29）
   ============================================================ */
.table-toolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 12px 16px;
  margin: -20px -16px 16px;
  border-bottom: 1px solid var(--gray-2);
  display: flex;
  gap: 12px;
  align-items: center;
  flex-wrap: wrap;
}
.table-search {
  flex: 1;
  min-width: 180px;
  height: 40px;
  padding: 0 14px;
  border-radius: 10px;
  border: 1.5px solid var(--gray-3);
  font-size: 15px;
  outline: none;
  transition: all 0.2s;
  background: #fff;
}
.table-search:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(232, 74, 42, 0.12);
}
.table-search::placeholder {
  color: var(--gray-4);
}
.table-filter-tabs {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}
.filter-tab {
  padding: 8px 16px;
  border-radius: 20px;
  border: 1px solid var(--gray-3);
  background: #fff;
  font-size: 13px;
  font-weight: 600;
  color: var(--gray-5);
  cursor: pointer;
  transition: all 0.2s;
  white-space: nowrap;
}
.filter-tab:hover {
  border-color: var(--primary);
  color: var(--primary);
}
.filter-tab.active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
  box-shadow: 0 4px 12px rgba(232, 74, 42, 0.25);
}

/* 更醒目的桌台状态色 */
.table-card .status.occupied {
  background: linear-gradient(135deg, #ff6b4a, #e84a2a);
  color: #fff;
  box-shadow: 0 2px 8px rgba(232, 74, 42, 0.3);
}
.table-card .status.available {
  background: #e8f5e9;
  color: #2e7d32;
}

/* 移动端适配 */
@media (max-width: 600px) {
  .table-toolbar {
    margin: -16px -16px 12px;
    padding: 10px 12px;
    gap: 8px;
  }
  .table-search {
    height: 36px;
    font-size: 14px;
  }
  .filter-tab {
    padding: 6px 12px;
    font-size: 12px;
  }
}

/* ============================================================
   订单折叠/展开（2026-09-29）
   ============================================================ */
.order-block {
  margin-top: 8px;
  padding-top: 6px;
  border-top: 1px dashed var(--gray-2);
}
.order-block.collapsed .order-head {
  margin-bottom: 0;
}
.order-block.expanded .order-head {
  margin-bottom: 6px;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 6px 8px;
  margin: 0 -4px;
  border-radius: 8px;
  transition: background 0.15s;
  user-select: none;
}
.order-head:hover {
  background: rgba(0, 0, 0, 0.03);
}
.order-head:active {
  background: rgba(0, 0, 0, 0.06);
}

.order-head-left {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.order-head-right {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.order-arrow {
  color: var(--gray-4);
  font-size: 10px;
  width: 12px;
  text-align: center;
  flex-shrink: 0;
  transition: transform 0.15s;
}

.order-no {
  font-weight: 700;
  color: var(--gray-6);
  font-size: 13px;
  white-space: nowrap;
}

.order-dish-count {
  font-size: 11px;
  color: var(--gray-4);
  padding: 1px 6px;
  border-radius: 8px;
  background: var(--gray-1);
  white-space: nowrap;
  flex-shrink: 0;
}

.order-amount {
  font-weight: 700;
  color: var(--primary);
  font-size: 14px;
  white-space: nowrap;
}

.pending-tip {
  font-size: 11px;
  font-weight: 600;
