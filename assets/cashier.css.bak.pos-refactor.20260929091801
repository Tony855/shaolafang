/* Extracted from cashier.html on 2026-09-28 */

:root{
      --primary: #667eea;
      --primary-light: #764ba2;
      --primary-dark: #5a67d8;
      --primary-bg: #f0f4ff;
      --gray-1: #f8f9fb;
      --gray-2: #eef0f2;
      --gray-3: #d5d8dd;
      --gray-4: #9ea3ac;
      --gray-5: #6b7078;
      --gray-6: #2d3138;
      --radius: 16px;
      --radius-sm: 10px;
      --shadow: 0 8px 30px rgba(0,0,0,0.08);
      --shadow-hover: 0 12px 40px rgba(0,0,0,0.15);
      --transition: 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body{
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
      color: var(--gray-6);
      min-height: 100vh;
      padding-bottom: 70px;
      background: linear-gradient(145deg, #f0f4ff 0%, #e8ecf8 100%);
    }
    header{
      position: sticky; top: 0; z-index: 100;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #fff; padding: 12px 16px;
      display: flex; align-items: center; justify-content: space-between;
      box-shadow: 0 4px 20px rgba(102,126,234,0.3);
    }
    .header-left{ display: flex; align-items: center; gap: 10px; }
    .header-logo{ font-size: 20px; }
    .header-title{ font-size: 17px; font-weight: 700; }
    .header-store{ font-size: 12px; opacity: 0.9; }
    .header-right{ display: flex; align-items: center; gap: 8px; }
    .header-btn{
      background: rgba(255,255,255,0.2); border: none; color: #fff;
      padding: 6px 12px; border-radius: 20px; font-size: 13px; cursor: pointer;
    }
    .lang-select{
      background: rgba(255,255,255,0.2); border: none; color: #fff;
      padding: 6px 8px; border-radius: 20px; font-size: 13px; cursor: pointer;
    }
    .lang-select option{ color: #333; }
    .tabs{
      display: flex; background: #fff; padding: 0 16px;
      border-bottom: 1px solid var(--gray-2); position: sticky; top: 56px; z-index: 99;
    }
    .tab{
      flex: 1; text-align: center; padding: 12px 0; font-size: 14px; font-weight: 600;
      color: var(--gray-4); cursor: pointer; border-bottom: 3px solid transparent;
      transition: all 0.2s;
    }
    .tab.active{ color: var(--primary); border-bottom-color: var(--primary); }
    .tab[data-tab="settled"].active{ color: #27ae60; border-bottom-color: #27ae60; }
    .tab[data-tab="report"].active{ color: #6c5ce7; border-bottom-color: #6c5ce7; }
    .content{ padding: 16px; }
    .order-card{
      background: #fff; border-radius: 12px; padding: 14px 16px;
      margin-bottom: 12px; box-shadow: 0 2px 12px rgba(0,0,0,0.08);
      border-left: 4px solid var(--primary); transition: all 0.2s;
    }
    .order-card:hover{ box-shadow: 0 4px 16px rgba(0,0,0,0.12); transform: translateY(-1px); }
    .order-card.status-done{ border-left-color: #43e97b; }
    .order-card.status-canceled{ border-left-color: #f5576c; opacity: 0.7; }
    .order-card.status-refunded{ border-left-color: #ffa726; opacity: 0.7; }
    .order-header{ display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 8px; }
    .order-table{ display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--gray-6); flex-wrap: wrap; }
    .order-table-icon{
      display: inline-flex; align-items: center; justify-content: center;
      width: 32px; height: 32px; border-radius: 8px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #fff; font-size: 14px; flex-shrink: 0;
    }
    .order-table-name{ font-size: 20px; font-weight: 700; color: var(--gray-6); }
    .order-id-badge{
      display: inline-flex; align-items: center;
      background: #f0f2ff; color: #667eea;
      font-size: 14px; font-weight: 700; padding: 3px 10px;
      border-radius: 6px; flex-shrink: 0;
    }
    .customer-tag{
      display: inline-flex; align-items: center; gap: 4px;
      background: #fff3e0; color: #e65100;
      font-size: 14px; font-weight: 600; padding: 3px 10px;
      border-radius: 6px; flex-shrink: 0;
    }
    .customer-tag.staff{ background: #e8f5e9; color: #2e7d32; }
    .order-status{
      font-size: 12px; padding: 4px 12px; border-radius: 12px; font-weight: 600;
      flex-shrink: 0; white-space: nowrap;
    }
    .order-status.pending{ background: #fff3cd; color: #856404; }
    .order-status.done{ background: #d4edda; color: #155724; }
    .order-status.canceled{ background: #f8d7da; color: #721c24; }
    .order-status.refunded{ background: #ffe0b2; color: #e65100; }
    .order-info{ font-size: 13px; color: var(--gray-4); margin-bottom: 8px; display: flex; align-items: center; gap: 4px; }
    .order-dishes{ font-size: 13px; color: var(--gray-5); margin-bottom: 10px; line-height: 1.5; }
    .order-dish-row{
      display: flex; justify-content: space-between; align-items: center;
      padding: 4px 8px; border-bottom: 1px dashed var(--gray-2); font-size: 13px;
      border-radius: 4px;
    }
    .order-dish-row:nth-child(odd){ background: rgba(102,126,234,0.05); }
    .order-dish-row:nth-child(even){ background: transparent; }
    .order-dish-row:last-child{ border-bottom: none; }
    .order-dish-left{ display: flex; align-items: center; flex: 1; min-width: 0; }
    .order-dish-name{ color: var(--gray-6); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .order-dish-qty{ color: var(--primary); font-weight: 700; margin-left: 12px; width: 45px; text-align: right; flex-shrink: 0; }
    .order-dish-unit{ color: #e67e22; font-size: 13px; margin-left: 8px; min-width: 60px; text-align: right; flex-shrink: 0; font-weight: 600; }
    .order-dish-price{ color: var(--gray-5); font-weight: 600; margin-left: 12px; width: 70px; text-align: right; flex-shrink: 0; }
    .order-footer{ display: flex; justify-content: space-between; align-items: center; }
    .order-total{ font-size: 18px; font-weight: 700; color: var(--primary); }
    .order-actions{ display: flex; gap: 8px; }
    .btn{
      padding: 7px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      cursor: pointer; border: none; transition: all 0.2s;
    }
    .btn-primary{ background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
    .btn-primary:hover{ transform: translateY(-2px); box-shadow: 0 4px 12px rgba(102,126,234,0.3); }
    .btn-warning{ background: linear-gradient(135deg, #ffd93d, #ff9f43); color: #fff; }
    .btn-warning:hover{ transform: translateY(-2px); }
    .btn-danger{ background: linear-gradient(135deg, #ff6b6b, #ee5a5a); color: #fff; }
    .btn-danger:hover{ transform: translateY(-2px); }
    .btn-secondary{ background: var(--gray-2); color: var(--gray-5); }
    .btn:disabled{ opacity: 0.4; cursor: not-allowed; transform: none !important; }
    .bottom-bar{
      position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
      padding: 12px 16px; box-shadow: 0 -4px 20px rgba(0,0,0,0.08);
      display: flex; justify-content: space-around; align-items: center; z-index: 100;
    }
    .stat-item{ text-align: center; }
    .stat-value{ font-size: 18px; font-weight: 700; color: var(--primary); }
    .stat-label{ font-size: 11px; color: var(--gray-4); }
    .modal-overlay{
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.55); z-index: 300; display: none;
      align-items: center; justify-content: center; padding: 16px;
    }
    .modal-overlay.show{ display: flex; }
    .modal{
      position: relative; background: #2d2d44; border: 1px solid #55557b;
      border-radius: 16px; width: 100%; max-width: 420px;
      max-height: 85vh; overflow-y: auto; padding: 18px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.35);
    }
    .modal-close{
      position: absolute; top: 12px; right: 12px; width: 30px; height: 30px;
      border: 0; border-radius: 50%; background: rgba(255,255,255,0.09);
      color: #fff; cursor: pointer; font-size: 14px; display: flex;
      align-items: center; justify-content: center; transition: all 0.2s;
    }
    .modal-close:hover{ background: rgba(255,255,255,0.18); }
    .modal-title{ font-size: 18px; font-weight: 700; margin-bottom: 16px; color: #ffd93d; padding-right: 36px; }
    .modal-section{ margin-bottom: 16px; }
    .modal-section-title{ font-size: 14px; font-weight: 600; color: #aaa; margin-bottom: 8px; }
    .dish-item{
      display: flex; justify-content: space-between; align-items: center; padding: 8px 10px;
      border-bottom: 1px solid rgba(255,255,255,0.08); font-size: 14px; border-radius: 4px;
    }
    .dish-item:nth-child(odd){ background: rgba(255,255,255,0.04); }
    .dish-item:nth-child(even){ background: transparent; }
    .dish-item .dish-left{ display: flex; align-items: center; flex: 1; }
    .dish-item .dish-name{ color: #333; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; }
    .dish-item .dish-qty{ color: #999; margin-left: 12px; width: 45px; text-align: right; flex-shrink: 0; }
    .dish-item .dish-unit{ color: #999; font-size: 12px; margin-left: 6px; width: 55px; text-align: right; flex-shrink: 0; }
    .dish-item .dish-price{ color: #e67e22; font-weight: 700; margin-left: 12px; width: 80px; text-align: right; flex-shrink: 0; }
    .modal-total{
      display: flex; justify-content: space-between; padding: 14px 0 4px;
      border-top: 2px solid rgba(255,255,255,0.12); font-size: 16px; font-weight: 700; color: #fff;
    }
    .modal-total .amount{ color: #ffd93d; }
    .modal-actions{ display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end; }
    .modal-actions .btn{
      border: 0; border-radius: 8px; padding: 9px 18px; background: #484867;
      color: #fff; cursor: pointer; font-size: 14px; font-weight: 500; transition: all 0.2s;
    }
    .modal-actions .btn:hover{ background: #5a5a80; }
    .modal-actions .btn.btn-primary{ background: linear-gradient(135deg, #f76b46, #df4d32); font-weight: 700; }
    .modal-actions .btn.btn-primary:hover{ background: linear-gradient(135deg, #ff7a55, #e85a3f); }
    .modal-actions .btn.btn-warning{ background: linear-gradient(135deg, #f5a623, #e8941a); font-weight: 700; }
    .modal-actions .btn.btn-warning:hover{ background: linear-gradient(135deg, #ffb535, #f5a020); }
    .modal-actions .btn.btn-danger{ background: linear-gradient(135deg, #e74c3c, #c0392b); font-weight: 700; }
    .modal-actions .btn.btn-danger:hover{ background: linear-gradient(135deg, #ff5c4a, #d64535); }
    .empty-hint{ text-align: center; padding: 40px 20px; color: var(--gray-4); }
    .empty-icon{ font-size: 48px; margin-bottom: 12px; }
    .report-card{
      background: linear-gradient(135deg, #667eea, #764ba2); color: #fff;
      border-radius: var(--radius); padding: 20px; margin-bottom: 16px;
    }
    .report-title{ font-size: 14px; opacity: 0.9; margin-bottom: 8px; }
    .report-amount{ font-size: 32px; font-weight: 700; margin-bottom: 16px; }
    .report-stats{ display: flex; justify-content: space-around; }
    .report-stat{ text-align: center; }
    .report-stat-value{ font-size: 20px; font-weight: 700; }
    .report-stat-label{ font-size: 12px; opacity: 0.8; }
    .login-modal{ display: none; }
    html:not([data-cashier-session="1"]) .login-modal{ display: flex; }
    html:not([data-cashier-session="1"]) .app-content{ display: none; }
