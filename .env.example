PORT=3000
# Same-host Nginx: loopback. For remote proxy nodes, set a private interface address.
HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_USER=foodflow
DB_PASSWORD=replace_with_a_long_random_password
DB_DATABASE=foodflow_system
DB_PORT=3306
UPLOAD_DIR=./uploads
RUN_SCHEDULED_TASKS=false
# Comma-separated origins for cross-origin frontends; leave empty for same-origin only.
CORS_ORIGINS=
# Nginx on the same host: loopback. Set deliberately if using a trusted remote proxy.
TRUST_PROXY=loopback
# Set true only for multi-node deployments that require shared Redis and Socket.IO.
REQUIRE_SHARED_REDIS=false

# Optional Telegram delivery worker (disabled by default)
TELEGRAM_NOTIFICATION_WORKER_ENABLED=false
# Required for private customer Telegram binding webhook; generate with: openssl rand -hex 32
TELEGRAM_CLIENT_WEBHOOK_SECRET=
